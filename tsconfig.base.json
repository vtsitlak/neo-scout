{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@neo-scout/pages/home": ["./libs/pages/home/src/index.ts"],
      "@neo-scout/pages/scout": ["./libs/pages/scout/src/index.ts"],
      "@neo-scout/pages/contact": ["./libs/pages/contact/src/index.ts"],
      "@neo-scout/shared/ui": ["./libs/shared/ui/src/index.ts"],
      "@neo-scout/stores/theme": ["./libs/stores/theme/src/index.ts"],
      "@neo-scout/api": ["./libs/api/src/index.ts"],
      "@neo-scout/stores/scout": ["./libs/stores/scout/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
